{
    "name": "blog-page",
    "version": 1,
    "page_type": "utility",
    "elementor_template_ref": "lp-standard-v1",
    "seo_profile_ref": "standard",
    "slots": [
        {
            "key": "hero_headline",
            "label": "Hero Headline",
            "content_type": "heading",
            "role": "hero_solution",
            "source": "generated",
            "cardinality": { "type": "single" },
            "constraints": { "required": true, "min_length": 6, "max_length": 90 },
            "client_override": true,
            "generation_hint": "A headline for the brand's articles page — what a homeowner learns here. The article list itself is rendered from the published posts, never invented.",
            "seo_binding": "h1",
            "elementor_binding": "lp/text"
        },
        {
            "key": "intro",
            "label": "Intro",
            "content_type": "short_text",
            "role": "body_explainer",
            "source": "generated",
            "cardinality": { "type": "single" },
            "constraints": { "required": false, "max_length": 220 },
            "client_override": true,
            "generation_hint": "One line inviting the reader to browse the articles below. No specific article titles — those come from the published posts.",
            "seo_binding": "meta_description",
            "elementor_binding": "lp/text"
        }
    ]
}
